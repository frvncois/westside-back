{
  "kind": "collectionType",
  "collectionName": "directors",
  "info": {
    "singularName": "director",
    "pluralName": "directors",
    "displayName": "Director",
    "description": "Film directors roster"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "order": {
      "type": "integer"
    },
    "hero": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "videos"]
    },
    "excerpt": {
      "type": "text"
    },
    "information": {
      "type": "text"
    },
    "links": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "gallery": {
      "type": "component",
      "repeatable": true,
      "component": "director.gallery-row"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
