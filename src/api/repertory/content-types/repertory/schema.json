{
  "kind": "collectionType",
  "collectionName": "repertories",
  "info": {
    "singularName": "repertory",
    "pluralName": "repertories",
    "displayName": "Repertory",
    "description": "Directors and photographers roster"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "disciplines": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::discipline.discipline"
    },
    "excerpt": {
      "type": "text"
    },
    "information": {
      "type": "text"
    },
    "links": {
      "type": "component",
      "repeatable": true,
      "component": "shared.link"
    },
    "gallery": {
      "type": "component",
      "repeatable": true,
      "component": "repertory.gallery-row"
    }
  }
}
