{
  "collectionName": "components_hero_slides",
  "info": {
    "displayName": "Slide",
    "icon": "picture",
    "description": "A hero slide: media paired with the director or photographer it links to"
  },
  "options": {},
  "attributes": {
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "duration": {
      "type": "decimal",
      "min": 1
    },
    "director": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::director.director"
    },
    "photographer": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::photographer.photographer"
    }
  }
}
