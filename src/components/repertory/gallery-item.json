{
  "collectionName": "components_repertory_gallery_items",
  "info": {
    "displayName": "Gallery Item",
    "icon": "picture",
    "description": "A single gallery entry with its taxonomy"
  },
  "options": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "title": {
      "type": "string"
    },
    "client": {
      "type": "string"
    },
    "filter": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "films",
        "photography"
      ]
    }
  }
}
